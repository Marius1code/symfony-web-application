{% extends 'base.html.twig' %}

{% block title %}Clients{% endblock %}

{% block body %}
<h1>Clients</h1>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" value="{{ search }}" class="form-control" placeholder="Rechercher un client par nom...">
        <button class="btn btn-outline-primary" type="submit"><i class="fas fa-search"></i> Rechercher</button>
        <a href="{{ path('client_new') }}" class="btn btn-primary ms-2"><i class="fas fa-plus"></i> Nouveau client</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Téléphone</th>
            <th>Email</th>
            <th>Adresse</th>
            <th>Créé le</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for client in clients %}
            <tr>
                <td>{{ client.name }}</td>
                <td>{{ client.phone }}</td>
                <td>{{ client.email }}</td>
                <td>{{ client.address }}</td>
                <td>{{ client.createdAt|date('d/m/Y H:i') }}</td>
                <td>
                    <a href="{{ path('client_edit', {'id': client.id}) }}" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i> Modifier</a>
                    <form method="post" action="{{ path('client_delete', {'id': client.id}) }}" style="display:inline-block;" onsubmit="return confirm('Voulez-vous vraiment supprimer ce client ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ client.id) }}">
                        <button class="btn btn-sm btn-danger" type="submit"><i class="fas fa-trash"></i> Supprimer</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" class="text-center">Aucun client trouvé.</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
