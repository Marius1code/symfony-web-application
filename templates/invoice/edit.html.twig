{% extends 'base.html.twig' %}

{% block title %}Modifier facture{% endblock %}

{% block body %}
<h1>Modifier la facture</h1>

{{ form_start(form) }}
    {{ form_row(form.client) }}
    {{ form_row(form.date) }}

    <h3>Lignes de facture</h3>
    <div data-prototype="{{ form_widget(form.lines.vars.prototype)|e('html_attr') }}">
        {{ form_widget(form.lines) }}
    </div>

    <button class="btn btn-primary">Enregistrer</button>
    <a href="{{ path('invoice_index') }}" class="btn btn-secondary">Annuler</a>
{{ form_end(form) }}
{% endblock %}
